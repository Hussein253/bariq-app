# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# مخرجات معاينة مؤقتة (ليست مصدراً)
# بلا علامتي تنصيص: gitignore لا يفسّرهما، فالنمط "Claude outputs"/ كان
# يطابق مجلداً تحمل العلامتان اسمه حرفياً، ويترك المجلد الحقيقي مكشوفاً.
Claude outputs/

# ذاكرة Supabase CLI المحلية (نسخة الأداة وما شابه) — تختلف من جهاز لآخر
supabase/.temp/

# ملف المثال ليس سرّاً — يوثّق أسماء المتغيّرات المطلوبة ويشير إليه README.
# يجب أن يُتتبَّع، والنمط .env* أعلاه كان يستبعده فيصل المطوّر الجديد بلا دليل.
!.env.example

.vercel
.env*
