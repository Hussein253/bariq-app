# ============================================================
# Supabase
# ============================================================

# عنوان مشروع Supabase (Supabase Dashboard → Project Settings → API URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# مفتاح anon public — يُستخدم في المتصفح ويُحكم بسياسات RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# مفتاح service_role — للخادم حصراً، يتجاوز RLS
# ⚠️ لا يُستورد أبداً في كود المتصفح ولا يُوضع في متغيّر يبدأ بـ NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ⚠️ هذه الثلاثة إلزامية للبناء نفسه لا للتشغيل فقط: lib/supabase-server.ts
# يُنشئ العميل لحظة تحميل الوحدة، و next build يحمّل كل مسار ليجمع بياناته —
# فغياب أيّها يُسقط البناء كله بـ "Failed to collect page data".
#
# وفي Vercel تُضبط لكل بيئة على حدة. ⚠️ بيئة Preview تأخذ مفاتيح **مشروع
# Supabase منفصل** لا مفاتيح الإنتاج: service_role يتجاوز RLS، ووضعه في
# المعاينة يعني أن كل فرع قيد المراجعة يكتب في بيانات التجار والشحنات
# الحقيقية. التفاصيل في docs/preview-environment.md

# ============================================================
# مالك المنصة (اختياري)
# ============================================================
#
# البريد الذي يدخل بدور platform_owner (لوحة /admin) عند أول دخول له. كل
# بريد آخر يدخل مشتركاً (merchant) على باقة Spark المجانية تلقائياً.
#
# اتركه فارغاً ليُستعمل المالك الافتراضي المكتوب في lib/platform-owner.ts.
# عدّة مُلّاك؟ افصل بفاصلة: a@x.com,b@y.com
#
# ⚠️ يُقرأ لحظة **إنشاء** صفّ الصلاحية فقط. تغييره لا ينزع الدور عمّن أخذه
# ولا يمنحه لحساب قائم — ذلك من /admin/users.
PLATFORM_OWNER_EMAILS=

# ============================================================
# أسرار توقيع الـ Webhooks (إلزامية)
# ============================================================
#
# كل مسار webhook يكتب في قاعدة البيانات يتحقق من توقيع HMAC-SHA256 على
# الجسم الخام. المسار يعمل بمبدأ الفشل المغلق: إن غاب السرّ يردّ ٥٠٣ ولا
# يقبل شيئاً. هذا مقصود — نسيان ضبط السرّ يجب أن يوقف المسار لا أن يفتحه.
#
# توليد سرّ قوي:  openssl rand -hex 32
#
# وعلى الطرف المُرسِل (n8n مثلاً) يُحسب التوقيع هكذا ويُرسل في الترويسة:
#   x-bariq-signature: sha256=<HMAC_SHA256(raw_body, secret)>

# سرّ مسار /api/webhooks/bot — أحداث بوتات المحادثة
BARIQ_BOT_WEBHOOK_SECRET=

# سرّ مسار /api/delivery/sync — تحديثات حالة الشحنة من نظام التوصيل
BARIQ_DELIVERY_SYNC_SECRET=

# ============================================================
# n8n
# ============================================================

# نقطة الإرسال في n8n التي تُوصل ردود لوحة التحكم إلى واتساب.
# إن غابت، تُحفظ الرسالة في المحادثة ولا تُرسل، ويُبلَّغ المستخدم بذلك.
N8N_WEBHOOK_URL=

# ============================================================
# بوابات الدفع الإلكتروني — غير مُفعّلة
# ============================================================
#
# لا توجد متغيّرات دفع هنا عمداً. تكامل زين كاش وكي كارد غير مبنيّ بعد،
# والمسارات ترد ٥٠١. التفاصيل وما يلزم للتفعيل في lib/payments/index.ts.
# لا تُضف مفاتيح دفع حتى يُبنى التكامل الحقيقي: مفتاح موجود بلا كود يستعمله
# يوحي بجاهزية غير قائمة.
